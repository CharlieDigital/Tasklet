# Google does not publish an official Firebase emulator image, so we just make one

FROM node:24-alpine
ARG FIREBASE_VERSION=15.19.1
RUN apk --no-cache add openjdk21-jre bash curl && \
  npm cache clean --force && \
  npm i -g firebase-tools@$FIREBASE_VERSION
WORKDIR /srv/firebase
RUN printf '{ "emulators": { "auth": { "host": "0.0.0.0", "port": 9099 } } }\n' > firebase.json
COPY firebase-entrypoint.sh /usr/local/bin/firebase-entrypoint
RUN chmod +x /usr/local/bin/firebase-entrypoint
EXPOSE 9099
# The emulator only exports on a clean shutdown; Docker should ask Firebase to
# stop the same way a developer does locally.
STOPSIGNAL SIGINT
ENTRYPOINT ["firebase-entrypoint"]
