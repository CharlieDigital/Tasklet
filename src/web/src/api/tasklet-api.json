          "color": {
            "$ref": "#/components/schemas/Color"
          },
          "completedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "dueAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        },
        "description": "Request model for updating a Tasklet."
