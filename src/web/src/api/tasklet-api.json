        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Status"
              }
            ]
          },
          "priority": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Priority"
              }
            ]
          },
          "explicitOrder": {
            "type": [
              "null",
              "string"
            ]
          },
          "pinned": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "color": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Color"
              }
            ]
          },
          "completedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "dueAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        },
        "description": "Request model for creating a Tasklet."
      },
      "HealthResponse": {
        "required": [
          "status",
          "checkedAt"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Simple healthcheck response"
      },
      "Priority": {
        "enum": [
          "Eventually",
          "Low",
          "Medium",
          "High",
          "Critical"
        ]
      },
      "SortDirection": {
        "enum": [
          "Ascending",
          "Descending"
        ]
      },
      "Status": {
        "enum": [
          "NotStarted",
          "InProgress",
          "Completed",
          "Blocked"
        ]
      },
      "TaskletListResponse": {
        "required": [
          "items",
          "skip",
          "take"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskletResponse"
            }
          },
          "skip": {
            "type": "integer",
            "format": "int32"
          },
          "take": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "Response model for paged Tasklet API lists."
      },
      "TaskletResponse": {
        "required": [
          "id",
          "userId",
          "title",
          "body",
          "status",
          "priority",
          "explicitOrder",
          "pinned",
          "color",
          "createdAtUtc",
          "completedAtUtc",
          "dueAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "explicitOrder": {
            "type": [
              "null",
              "string"
            ]
          },
          "pinned": {
            "type": "boolean"
          },
          "color": {
            "$ref": "#/components/schemas/Color"
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "completedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "dueAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        },
        "description": "Response model for Tasklet API reads."
      },
