  "components": {
    "schemas": {
      "Color": {
        "enum": [
          "Amber",
          "Lime",
          "Emerald",
          "Cyan",
          "Blue",
          "Indigo",
          "Purple",
          "Pink",
          "Rose"
        ]
      },
      "CreateTaskletRequest": {
        "required": [
          "title",
          "body",
          "status",
          "priority",
          "explicitOrder",
          "pinned",
          "color",
          "completedAtUtc",
          "dueAtUtc"
